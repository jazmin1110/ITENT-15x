# One-time production seed from your laptop (Render free tier has no Shell).
#
# 1. Render dashboard → your Postgres database → Connect → copy "External Database URL"
# 2. Copy this file:  cp render_database.env.example render_database.env
# 3. Edit render_database.env and set DATABASE_URL to that URL (keep it secret; file is gitignored).
# 4. Run:  ./scripts/seed_render_production.sh
#
#DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
